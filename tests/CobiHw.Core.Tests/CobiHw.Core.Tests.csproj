<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tests for the platform-neutral Core and the Linux readers. No Windows dependency, so CI runs them on Linux too.
         xUnit v3 test projects are executables; dotnet test runs them through Microsoft Testing Platform. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CobiHw.Core\CobiHw.Core.csproj" />
    <ProjectReference Include="..\..\src\CobiHw.Core.Linux\CobiHw.Core.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

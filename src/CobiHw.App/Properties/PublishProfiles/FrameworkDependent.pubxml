<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- 64-bit by default; publish.ps1 passes -r win-x86 for the 32-bit package. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Framework-dependent package: smaller, but needs the .NET 10 Desktop Runtime installed. -->
    <SelfContained>false</SelfContained>
    <!-- One .exe; the license files stay next to it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- Used when publishing from Visual Studio; publish.ps1 sets its own folder. -->
    <PublishDir>..\..\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>

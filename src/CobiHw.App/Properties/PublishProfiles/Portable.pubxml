<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Portable package: includes the .NET runtime, so nothing needs to be installed. -->
    <SelfContained>true</SelfContained>
    <!-- One .exe; the license files stay next to it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- Used when publishing from Visual Studio; publish.ps1 sets its own folder. -->
    <PublishDir>..\..\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>

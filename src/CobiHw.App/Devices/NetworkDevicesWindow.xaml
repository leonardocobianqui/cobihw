<Window x:Class="CobiHw.App.Devices.NetworkDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:devices="clr-namespace:CobiHw.App.Devices"
        xmlns:loc="clr-namespace:CobiHw.App.Localization"
        xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=devices:NetworkDevicesViewModel}"
        Title="{loc:Text NetworkDevices_Title}"
        Width="760"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Language="{Binding Culture, Source={x:Static loc:Localizer.Instance}, Converter={x:Static loc:CultureToLanguageConverter.Instance}, ConverterCulture={x:Static glob:CultureInfo.InvariantCulture}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- Secondary text for hints and status lines. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Label and value; the row hides while the value is empty. -->
        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type devices:DetailRow}">
            <Grid Margin="0,3" Visibility="{Binding HasValue, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource InkMutedBrush}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Footer band: public IP lookup and Close. -->
        <Border DockPanel.Dock="Bottom" Padding="12,12,12,16" Style="{DynamicResource FooterBand}">
            <DockPanel>
                <Button DockPanel.Dock="Right" MinWidth="90" Padding="10,4" VerticalAlignment="Top" IsCancel="True" Content="{loc:Text Settings_Close}" Click="OnCloseClick" />
                <StackPanel Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{loc:Text PublicIp_Label}" />
                        <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PublicAddressText}" />
                        <Button Padding="10,4" Content="{loc:Text PublicIp_Discover}" Command="{Binding DiscoverPublicAddressCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Text PublicIp_Hint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="12">
            <!-- Loading and "no devices" messages. -->
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{loc:Text NetworkDevices_Loading}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{loc:Text NetworkDevices_None}"
                       Visibility="{Binding HasNoTabs, Converter={StaticResource BooleanToVisibility}}" />

            <Grid Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Device list. -->
                <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type devices:NetworkDeviceTabViewModel}">
                            <StackPanel Margin="0,2" ToolTip="{Binding AdapterName}">
                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkMutedBrush}" Text="{Binding AdapterName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Details of the selected device, with the Wi-Fi section below. -->
                <Border Grid.Column="1" Margin="12,0,0,0" BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="14,14,30,14" Grid.IsSharedSizeScope="True" DataContext="{Binding SelectedTab}">
                            <ItemsControl Focusable="False" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DetailRowTemplate}" />
                            <StackPanel Visibility="{Binding IsWifi, Converter={StaticResource BooleanToVisibility}}">
                                <Border Height="1" Margin="0,12" Background="{DynamicResource LineBrush}" />
                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="{loc:Text Wifi_Section}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding WifiRows}" ItemTemplate="{StaticResource DetailRowTemplate}"
                                              Visibility="{Binding ShowWifiRows, Converter={StaticResource BooleanToVisibility}}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding WifiMessage}" />
                                <Button Margin="0,8,0,0" Padding="10,4" HorizontalAlignment="Left" Content="{loc:Text Wifi_OpenLocationSettings}"
                                        Visibility="{Binding ShowLocationButton, Converter={StaticResource BooleanToVisibility}}" Click="OnOpenLocationSettingsClick" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>

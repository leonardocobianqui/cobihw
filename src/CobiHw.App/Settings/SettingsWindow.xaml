<!-- Settings window: four tabs (General, Display, Appearance, Network). Logic in SettingsViewModel; "Apply" acts on the open tab. -->
<!-- Window sizes include the 16 px of shadow on each side (WindowFrame.ShadowSize): 492 wide shows a 460 px window. -->
<Window x:Class="CobiHw.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:CobiHw.App.Settings"
        xmlns:loc="clr-namespace:CobiHw.App.Localization"
        xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
        Title="{loc:Text Settings_Title}"
        Width="492"
        Height="752"
        MinWidth="492"
        MinHeight="432"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Language="{Binding Culture, Source={x:Static loc:Localizer.Instance}, Converter={x:Static loc:CultureToLanguageConverter.Instance}, ConverterCulture={x:Static glob:CultureInfo.InvariantCulture}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- Content of each tab; the minimum height keeps the window from jumping when switching tabs. -->
        <Style x:Key="TabContent" TargetType="StackPanel">
            <Setter Property="Margin" Value="14" />
            <Setter Property="MinHeight" Value="270" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Draggable item row; faded while being dragged. -->
        <Style x:Key="MetricRow" TargetType="Border">
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary explanation under a control. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Divider between sections. -->
        <Style x:Key="SectionLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        </Style>

        <!-- Dot next to a tab name when it has changes not applied; same color as the tab name. -->
        <Style x:Key="PendingDot" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Text" Value="•" />
        </Style>

        <!-- Validation message. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer band with the buttons: Restore defaults (open tab), Close (asks about pending changes), Apply (open tab). -->
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource FooterBand}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="120" Margin="0,0,8,0" Padding="10,4" Content="{loc:Text Settings_RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" />
                <Button MinWidth="80" Margin="0,0,8,0" Padding="10,4" Content="{loc:Text Settings_Close}" IsCancel="True" Click="OnCloseClick" />
                <Button MinWidth="80" Padding="10,4" Style="{DynamicResource PrimaryButtonStyle}" Content="{loc:Text Settings_Apply}" IsDefault="True" Command="{Binding ApplyCommand}" />
            </StackPanel>
        </Border>

        <TabControl Margin="16,16,16,12" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTab}">
            <!-- General tab: language, theme, widget behavior, clicks, startup and settings file. -->
            <TabItem Tag="{x:Static settings:SettingsTab.General}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource TabHeaderText}" Text="{loc:Text Tab_General}" />
                        <TextBlock Style="{StaticResource PendingDot}" Visibility="{Binding IsGeneralPending, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text General_Language}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" SelectedValue="{Binding Language}" DisplayMemberPath="Name" />

                        <Border Style="{StaticResource SectionLine}" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text General_Theme}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Theme" SelectedValue="{Binding Theme}" DisplayMemberPath="Label" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_ThemeHint}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- Mode, monitor, snapping and position lock. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text General_Widget}" />
                        <TextBlock Margin="0,0,0,4" Text="{loc:Text General_Monitor}" />
                        <ComboBox IsEnabled="{Binding HasSeveralMonitors}" ItemsSource="{Binding MonitorOptions}" SelectedValuePath="Device" SelectedValue="{Binding Monitor}" DisplayMemberPath="Label" />
                        <TextBlock Margin="0,8,0,4" Text="{loc:Text General_Mode}" />
                        <ComboBox ItemsSource="{Binding ModeOptions}" SelectedValuePath="Mode" SelectedValue="{Binding Mode}" DisplayMemberPath="Label" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_ModeHint}" />
                        <CheckBox Margin="0,10,0,0" Content="{loc:Text Tray_SnapToEdges}" IsChecked="{Binding SnapToEdges}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_SnapHint}" />
                        <CheckBox Margin="0,10,0,0" Content="{loc:Text Tray_LockPosition}" IsChecked="{Binding PositionLocked}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_LockHint}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- Click-through and the key that temporarily disables it. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text General_Clicks}" />
                        <CheckBox Content="{loc:Text General_ClickThrough}" IsChecked="{Binding ClickThrough}" />
                        <TextBlock Margin="0,8,0,4" Text="{loc:Text General_InteractionKey}" />
                        <ComboBox IsEnabled="{Binding ClickThrough}" ItemsSource="{Binding KeyOptions}" SelectedValuePath="Key" SelectedValue="{Binding InteractionKey}" DisplayMemberPath="Label" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_ClickThroughHint}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text General_Startup}" />
                        <CheckBox Content="{loc:Text General_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- Where settings are saved, and cleanup of other computers' sections and of what was registered in Windows. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text General_SettingsFile}" />
                        <Button HorizontalAlignment="Left" Padding="10,4" Content="{loc:Text General_RemoveOtherProfiles}" Command="{Binding RemoveOtherProfilesCommand}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_RemoveOtherProfilesHint}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="10,4" Content="{loc:Text General_RemoveFromWindows}" Command="{Binding RemoveFromWindowsCommand}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text General_RemoveFromWindowsHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Display tab: items and their order, disk, GPU and details popup. -->
            <TabItem Tag="{x:Static settings:SettingsTab.Display}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource TabHeaderText}" Text="{loc:Text Tab_Display}" />
                        <TextBlock Style="{StaticResource PendingDot}" Visibility="{Binding IsDisplayPending, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text Display_ShowInWidget}" />
                        <StackPanel Margin="0,3" Orientation="Horizontal">
                            <TextBlock Width="22" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Text="&#xE72E;" />
                            <CheckBox VerticalAlignment="Center" Content="{loc:Text Metric_Fps}" IsChecked="{Binding ShowFps}" />
                        </StackPanel>
                        <!-- Item list: checkbox shows the item; drag a row to reorder (handled in code-behind). -->
                        <ItemsControl x:Name="MetricList" AllowDrop="True" Focusable="False" ItemsSource="{Binding Metrics}"
                                      PreviewMouseLeftButtonDown="OnMetricPreviewMouseLeftButtonDown"
                                      PreviewMouseMove="OnMetricPreviewMouseMove"
                                      DragOver="OnMetricDragOver"
                                      Drop="OnMetricDrop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:MetricRowViewModel}">
                                    <Border Style="{StaticResource MetricRow}" Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="22" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Text="&#xE76F;" />
                                            <CheckBox VerticalAlignment="Center" Cursor="Arrow" Content="{Binding Name}" IsChecked="{Binding IsVisible}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Display_DragHint}" />
                        <TextBlock Style="{StaticResource ErrorText}" Text="{loc:Text Display_SelectOne}"
                                   Visibility="{Binding HasDisplayError, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Display_FpsHint}" />
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding FpsNotice}"
                                   Visibility="{Binding HasFpsNotice, Converter={StaticResource BooleanToVisibility}}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- Disk shown in the widget, plus the optional read/write speed. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text Display_MonitoredDisk}" />
                        <ComboBox ItemsSource="{Binding DiskOptions}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="Label" />
                        <CheckBox Margin="0,8,0,0" Content="{loc:Text Display_ShowDiskSpeed}" IsChecked="{Binding ShowDiskSpeed}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- GPU shown in the widget, plus the optional temperature. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text Display_MonitoredGpu}" />
                        <ComboBox ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" DisplayMemberPath="Label" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Display_GpuHint}" />
                        <CheckBox Margin="0,8,0,0" Content="{loc:Text Display_ShowGpuTemperature}" IsChecked="{Binding ShowGpuTemperature}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Display_GpuTemperatureHint}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <CheckBox Content="{loc:Text Display_DetailedTooltip}" IsChecked="{Binding DetailedTooltip}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Display_DetailsHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance tab: one summary per group; "Edit" opens the group's editor window. -->
            <TabItem Tag="{x:Static settings:SettingsTab.Appearance}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource TabHeaderText}" Text="{loc:Text Tab_Appearance}" />
                        <TextBlock Style="{StaticResource PendingDot}" Visibility="{Binding IsAppearancePending, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Style="{StaticResource TabContent}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" MinWidth="90" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" Content="{loc:Text Appearance_Edit}"
                                    Command="{Binding EditAppearanceCommand}" CommandParameter="{x:Static settings:AppearanceGroup.Shape}" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Text Section_AppearanceShape}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding ShapeSummary}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SectionLine}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" MinWidth="90" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" Content="{loc:Text Appearance_Edit}"
                                    Command="{Binding EditAppearanceCommand}" CommandParameter="{x:Static settings:AppearanceGroup.TextColors}" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Text Section_AppearanceColors}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding TextColorsSummary}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SectionLine}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" MinWidth="90" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" Content="{loc:Text Appearance_Edit}"
                                    Command="{Binding EditAppearanceCommand}" CommandParameter="{x:Static settings:AppearanceGroup.UsageColors}" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{loc:Text Section_AppearanceUsage}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding UsageColorsSummary}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SectionLine}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Appearance_GroupsHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Network tab: monitored devices, default device, ping and speed test. -->
            <TabItem Tag="{x:Static settings:SettingsTab.Network}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource TabHeaderText}" Text="{loc:Text Tab_Network}" />
                        <TextBlock Style="{StaticResource PendingDot}" Visibility="{Binding IsNetworkPending, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Style="{StaticResource TabContent}">
                        <!-- Devices listed in "Network devices"; hidden ones only with "show hidden". -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text Network_Devices}" />
                        <TextBlock Margin="0,0,0,4" Text="{loc:Text Network_Monitor}" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding NetworkDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:NetworkDeviceRowViewModel}">
                                    <CheckBox Margin="0,2" IsChecked="{Binding IsMonitored}" Visibility="{Binding IsShown, Converter={StaticResource BooleanToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Network_NoDevices}"
                                   Visibility="{Binding HasNoNetworkDevices, Converter={StaticResource BooleanToVisibility}}" />
                        <CheckBox Margin="0,6,0,0" Content="{loc:Text Network_ShowInternal}" IsChecked="{Binding ShowInternalDevices}" />
                        <TextBlock Margin="0,10,0,4" Text="{loc:Text Network_Default}" />
                        <ComboBox ItemsSource="{Binding DefaultDeviceOptions}" SelectedItem="{Binding SelectedDefaultDevice}" DisplayMemberPath="Label" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Network_DevicesHint}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- Ping is off by default; with it off, the app makes no automatic connections. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text Network_Ping}" />
                        <CheckBox Margin="0,0,0,8" Content="{loc:Text Network_PingEnabled}" IsChecked="{Binding PingEnabled}" />
                        <TextBlock Margin="0,0,0,4" Text="{loc:Text Network_Address}" IsEnabled="{Binding PingEnabled}" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding PingSuggestions}" Text="{Binding PingHostText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PingEnabled}" />
                        <TextBlock Style="{StaticResource ErrorText}" Text="{loc:Text Network_AddressError}"
                                   Visibility="{Binding HasPingHostError, Converter={StaticResource BooleanToVisibility}}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Network_PingHint}" />

                        <Border Style="{StaticResource SectionLine}" />
                        <!-- Speed test: the button starts it and the app opens the speed test window; below, the last result or the current step. -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Text SpeedTest_Title}" />
                        <Button HorizontalAlignment="Left" MinWidth="110" Padding="10,4" Content="{loc:Text Network_TestNow}" Command="{Binding SpeedTest.RunCommand}" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SpeedTest.StatusText}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Text Network_DataHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

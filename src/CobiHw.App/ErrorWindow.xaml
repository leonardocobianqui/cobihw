<Window x:Class="CobiHw.App.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CobiHw.App.Localization"
        xmlns:glob="clr-namespace:System.Globalization;assembly=System.Runtime"
        Title="{loc:Text App_UnexpectedError}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
        Language="{Binding Culture, Source={x:Static loc:Localizer.Instance}, Converter={x:Static loc:CultureToLanguageConverter.Instance}, ConverterCulture={x:Static glob:CultureInfo.InvariantCulture}}">

    <!-- Message and expandable details, with the buttons in the footer band; Close has the focus and Esc closes. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource FooterBand}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" MinWidth="120" Padding="10,4" Content="{loc:Text Error_CopyDetails}" Click="OnCopyClick" />
                <Button x:Name="CloseButton" Margin="8,0,0,0" MinWidth="90" Padding="10,4" Style="{DynamicResource PrimaryButtonStyle}" IsCancel="True" Content="{loc:Text Settings_Close}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="16,16,16,12">
            <TextBlock TextWrapping="Wrap" Text="{loc:Text Error_Message}" />

            <Expander Margin="0,12,0,0" Header="{loc:Text Error_Details}">
                <TextBox x:Name="DetailsBox" Height="180" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Expander>
        </StackPanel>
    </DockPanel>
</Window>

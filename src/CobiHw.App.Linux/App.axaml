<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CobiHw.App.Linux.App"
             Name="cobihw">
    <!-- Fluent supplies the base control styles; the widget draws its own look on top of them. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
